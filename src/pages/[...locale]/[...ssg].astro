---
import { isDev } from "@/core/configuration/app-configuration"
import { nonDefaultLocales } from "@/core/configuration/i18n-configuration"
import Layout from "@/core/layouts/Layout.astro"
import { descriptionMessages } from "@/core/translation/description-translation"
import { titleMessages } from "@/core/translation/title-translation"
import { AppEntry } from "@/pages/_app/entry"
import { handleSsrRequest } from "@/pages/_app/handle-ssr-request"
import type { GetStaticPaths } from "astro"
import { currentLocale } from "astro-nanostores-i18n:runtime"
import type { ComponentProps } from "astro/types"

// Context
type Props = ComponentProps<typeof Layout>

export const prerender = !isDev // Live render in dev

export const getStaticPaths = (() => {
  const locales = [...nonDefaultLocales, undefined]

  const routes = [undefined, "quiz/new/ai", "settings/preferences"]

  return locales.flatMap((locale) => {
    currentLocale.set(locale ?? ("en" as string))

    return routes.map((ssg) => ({
      params: { locale, ssg },
      props: {
        title: ssg
          ? titleMessages.get()[ssg as keyof (typeof titleMessages)["get"]]
          : titleMessages.get().home,
        description: ssg
          ? descriptionMessages.get()[
              ssg as keyof (typeof descriptionMessages)["get"]
            ]
          : descriptionMessages.get().home,
      },
    }))
  })
}) satisfies GetStaticPaths

// Handle redirect response
const { redirectResponse, getServerRouter, scriptHtml } =
  await handleSsrRequest(Astro)

if (redirectResponse) return redirectResponse

// Page props
const { props } = Astro
---

<Layout {...props}>
  <AppEntry client:load getServerRouter={getServerRouter} />

  <Fragment set:html={scriptHtml} />
</Layout>
