---
import Styles from "@/core/components/atoms/Styles.astro"
import Sonner from "@/core/components/molecules/Sonner.astro"
import { site, siteUrl } from "@/core/configuration/app-configuration"
import {
appName,
author,
defaultDescription,
defaultKeywords,
} from "@/core/constant/seo-constant"
import { getTitle } from "@/core/kit/title-kit"
import { currentLocale } from "astro-nanostores-i18n:runtime"
import { getImagePath } from "astro-opengraph-images"
import { pwaAssetsHead } from "virtual:pwa-assets/head"
import { pwaInfo } from "virtual:pwa-info"

// Context
interface Props {
  title?: string
  description?: string
  keywords?: string
  noLang?: boolean
}

const {
  title,
  description = defaultDescription,
  keywords = defaultKeywords,
  noLang,
} = Astro.props

// Title
const fullTitle = getTitle(title)

// Site
const { url } = Astro

// Url
const { hostname } = Astro.url
const isProdHostname = hostname === siteUrl.hostname

// Open graph image
let ogImageUrl = getImagePath({ url, site: siteUrl })

if (!ogImageUrl.endsWith("index.png"))
  ogImageUrl = ogImageUrl.replace(/\.png$/, "") + "/index.png"
---

<!doctype html>
<html lang={noLang ? undefined : currentLocale.get()} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{fullTitle}</title>

    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap-index.xml"
    />
    <link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />

    <meta name="author" content={author} />
    <meta name="keywords" content={keywords} />
    <meta name="description" content={description} />

    <link rel="canonical" href={site} />
    <link rel="alternate" hreflang="en" href={site} />
    <link rel="alternate" hreflang="es" href=`${site}/es` />

    <meta property="og:site_name" content="Quiz" />
    <meta property="og:url" content={site} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:locale" content="es" />
    <meta property="og:description" content={description} />
    <slot name="og:image">
      <meta property="og:image" content={ogImageUrl} />
    </slot>
    <slot name="og:image:alt">
      <meta property="og:image:alt" content={appName} />
    </slot>
    <slot name="og:image:width">
      <meta property="og:image:width" content="1200" />
    </slot>
    <slot name="og:image:height">
      <meta property="og:image:height" content="630" />
    </slot>

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content={site.replace("https://", "")} />
    <meta name="twitter:url" content={site} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <slot name="twitter:image">
      <meta name="twitter:image" content={ogImageUrl} />
    </slot>
    <slot name="twitter:image:alt">
      <meta name="twitter:image:alt" content={appName} />
    </slot>
    <slot name="twitter:image:width">
      <meta name="twitter:image:width" content="1200" />
    </slot>
    <slot name="twitter:image:height">
      <meta name="twitter:image:height" content="630" />
    </slot>

    {
      pwaAssetsHead.themeColor && (
        <>
          <meta name="theme-color" content={pwaAssetsHead.themeColor.content} />
          <meta
            name="msapplication-TileColor"
            content={pwaAssetsHead.themeColor.content}
          />
        </>
      )
    }

    <meta name="msapplication-TileImage" content="/pwa-150x150.png" />
    {
      pwaAssetsHead.links.map((link) => (
        <link
          id={link.id}
          rel={link.rel}
          href={link.href}
          sizes={link.sizes}
          media={link.media}
          type={link.type}
        />
      ))
    }

    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}

    <slot name="head" />

    {/* Styles */}
    <Styles />

    {/* Scripts */}
    <Sonner />
    <script src="@/pwa.ts"></script>
    <script src="@/translation/store/i18n-store.ts"></script>
    <script src="@/core/scripts/cloudflare-email-decoder.ts"></script>
    {
      isProdHostname && (
        <script
          is:inline
          defer
          id="umami-script"
          src="https://umami.martindotpy.dev/script.js"
          data-website-id="493f7f6b-71bb-4e6f-a8f2-d4ab1d54602f"
        />
      )
    }
    <script src="@/core/scripts/umami-identify.ts"></script>
  </head>

  <body class="no-scrollbar! flex min-h-svh flex-col overflow-y-scroll!">
    <slot />
  </body>
</html>
